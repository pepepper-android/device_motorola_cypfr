# Charger
ro.charger.enable_suspend=1

# Display
debug.sf.enable_hwc_vds=1

# CNE
persist.vendor.cne.feature=1

# Data
persist.data.df.agg.dl_pkt=10
persist.data.df.agg.dl_size=4096
persist.data.df.dev_name=rmnet_usb0
persist.data.df.dl_mode=5
persist.data.df.iwlan_mux=9
persist.data.df.mux_count=8
persist.data.df.ul_mode=5

# Google
ro.opa.device_model_id=motorola-cypfr
ro.opa.eligible_device=true

# HWUI
debug.hwui.skia_atrace_enabled=false

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
ro.qcom.ims.use_moto_vt_ext=true

# Media
media.settings.xml=/vendor/etc/media_profiles_vendor.xml
ro.media.recorder-max-base-layer-fps=60

# Netmgrd
persist.vendor.data.mode=concurrent
ro.vendor.use_data_netmgrd=true

# Radio
#
# 27 = NR_LTE_CDMA_EVDO_GSM_WCDMA。stock の vendor/build.prop も
# device/motorola/sm4350-common/platform.mk も 27 で、33 を書いているのは
# ここだけだった。33 は NR_LTE_TDSCDMA_CDMA_EVDO_GSM_WCDMA で、27 に
# TD-SCDMA を足したもの - 中国向けの 3G 規格で、この端末にもこの地域にも
# 関係がない。
#
# 単に無駄なだけとは限らない。優先ネットワークモードは allowedNetworkTypes
# のビットマスクに変換されてモデムに渡され、モデムが対応しない RAT を
# 含むマスクは丸ごと拒否されることがある。そうなると設定が反映されず、
# モデムは既定の状態のまま残る。
#
# platform.mk の 27 は効いていない - あのファイルは (CommonConfig.mk や
# PlatformConfig.mk と同じく) どこからも include されていないため。
ro.telephony.default_network=27,27

# e-SIM
masterclear.allow_retain_esim_profiles_after_fdr=1

# RTT
config.disable_rtt=true

# Sensors
persist.vendor.sensors.enable.mag_filter=true

# SSR
persist.vendor.ssr.restart_level=ALL_ENABLE

# Vendor
ro.vendor.qti.va_aosp.support=1

# WFD
persist.debug.wfd.enable=1
persist.sys.wfd.virtual=0

# Zygote
persist.device_config.runtime_native.usap_pool_enabled=true

#Disable MTE Async for system server
arm64.memtag.process.system_server=off
