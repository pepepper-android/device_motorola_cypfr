on init
    mkdir /config
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/idVendor 0x22b8
    write /config/usb_gadget/g1/idProduct 0x2e81
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.fastboot
    write /config/usb_gadget/g1/os_desc/use 1
    write /config/usb_gadget/g1/os_desc/b_vendor_code 0x1
    write /config/usb_gadget/g1/os_desc/qw_sign "MSFT100"
    mkdir /config/usb_gadget/g1/configs/b.1 0777 shell shell
    symlink /config/usb_gadget/g1/configs/b.1 /config/usb_gadget/g1/os_desc/b.1
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

# The "sys.usb.config=adb" and "=fastboot" gadget blocks that used to live here
# are gone on purpose.
#
# init parses /system/etc/init/hw/init.rc first and only then the files it
# imports, so the generic blocks were registered before ours and ran first for
# the same trigger. The generic block symlinks ffs.adb into the config and binds
# the UDC; ours then immediately wrote UDC "none" and unlinked f1 before
# rebuilding the same configuration. Tearing the FunctionFS instance down that
# way throws away the descriptors adbd had already written, so the gadget came
# back up without a working adb interface and the host saw nothing at all - not
# even an "unauthorized" device.
#
# sideload was unaffected precisely because we had no block for it: the generic
# configuration was left alone and worked. Deleting these two blocks makes adb
# and fastboot take that same path. The generic blocks pick up our VID/PID from
# ro.recovery.usb.{vid,adb.pid,fastboot.pid}, which device.mk sets, so nothing
# device specific is lost.

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
