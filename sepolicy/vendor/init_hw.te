# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type init_hw, domain;
type init_hw_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(init_hw)

allow init_hw binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow init_hw bugreport_data_file:file { getattr write };
allow init_hw cgroup:dir { add_name lock open remove_name search write };
allow init_hw cgroup:file { append lock map open write };
allow init_hw cgroup_v2:dir { add_name lock open remove_name search write };
allow init_hw cgroup_v2:file { append lock map open write };
allow init_hw firmware_file:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw firmware_file:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw firmware_file:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_hw fsg_file:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw fsg_file:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw fsg_file:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_hw hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow init_hw init:unix_stream_socket { connectto };
allow init_hw kernel:key { search };
allow init_hw kmsg_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow init_hw mnt_vendor_file:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw mnt_vendor_file:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow init_hw netutils_wrapper:process { rlimitinh siginh transition };
allow init_hw netutils_wrapper_exec:file { execute getattr map open read };
allow init_hw oemfs:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw oemfs:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw proc_hwconf:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw proc_hwconf:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow init_hw property_socket:sock_file { write };
allow init_hw rootfs:lnk_file { getattr };
allow init_hw same_process_hal_file:file { execute getattr map open read };
allow init_hw self:capability { sys_module };
allow init_hw self:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw self:fd { use };
allow init_hw self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow init_hw self:file { append getattr ioctl lock map open read watch watch_reads write };
allow init_hw self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_hw self:lockdown { confidentiality };
allow init_hw self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow init_hw self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow init_hw self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow init_hw sysfs_dt_chosen:dir { search };
allow init_hw sysfs_dt_chosen:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_hw system_file:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw system_file:lnk_file { getattr };
allow init_hw vendor_audio_prop:file { getattr map open read };
allow init_hw vendor_audio_prop:property_service { set };
allow init_hw vendor_default_prop:file { getattr map open read };
allow init_hw vendor_display_prop:file { getattr map open read };
allow init_hw vendor_display_prop:property_service { set };
allow init_hw vendor_file:file { execute_no_trans };
allow init_hw vendor_file:system { module_load };
allow init_hw vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw vendor_file_type:file { execute getattr map open read };
allow init_hw vendor_file_type:lnk_file { getattr read };
allow init_hw vendor_hw_gabutton_prop:file { getattr map open read };
allow init_hw vendor_hw_gabutton_prop:property_service { set };
allow init_hw vendor_mot_boot_prop:file { getattr map open read };
allow init_hw vendor_mot_fingerprint_prop:file { getattr map open read };
allow init_hw vendor_mot_fingerprint_prop:property_service { set };
allow init_hw vendor_mot_hw_prop:file { getattr map open read };
allow init_hw vendor_mot_hw_prop:property_service { set };
allow init_hw vendor_mot_init_prop:file { getattr map open read };
allow init_hw vendor_mot_init_prop:property_service { set };
allow init_hw vendor_mot_product_prop:file { getattr map open read };
allow init_hw vendor_mot_product_prop:property_service { set };
allow init_hw vendor_mot_unique_id_prop:file { getattr map open read };
allow init_hw vendor_mot_var_prop:file { getattr map open read };
allow init_hw vendor_mot_var_prop:property_service { set };
allow init_hw vendor_persist_file:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw vendor_persist_file:lnk_file { read };
allow init_hw vendor_shell_exec:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw vendor_sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_kgsl:dir { search };
allow init_hw vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_toolbox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow init_hw vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };

type_transition init_hw crash_dump_exec:process crash_dump;
type_transition init_hw netutils_wrapper_exec:process netutils_wrapper;


# 上の細かい型は共通ツリーが既に vendor_mot_prop / vendor_nfc_prop で
# 拾っている接頭辞ぶんを持てないので、そちらにも同じ権限を与える。
allow init_hw vendor_mot_prop:file { getattr map open read };
allow init_hw vendor_mot_prop:property_service { set };

# 上の型が当たらないパスは共通ツリーが別の型で拾っているので、
# そちらにも同じ権限を与える。
allow init_hw vendor_proc_hw:dir { getattr ioctl lock open read search watch watch_reads };
allow init_hw vendor_proc_hw:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };

# 上の vendor_mot_*_prop は property_contexts から外したので、
# 実際に当たる bootloader_prop / vendor_default_prop 側にも与える。
allow init_hw bootloader_prop:file { getattr map open read };
allow init_hw vendor_default_prop:property_service { set };