# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type tcmd, domain, netdomain;
type tcmd_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(tcmd)

allow tcmd adspd:unix_stream_socket { connectto };
allow tcmd adspd_socket:sock_file { write };
allow tcmd audio_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmd audio_device:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmd binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmd block_device:dir { search };
allow tcmd bugreport_data_file:file { getattr write };
allow tcmd cgroup:dir { add_name lock open remove_name search write };
