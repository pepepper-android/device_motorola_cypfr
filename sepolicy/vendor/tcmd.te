allow tcmd self:qipcrtr_socket { append bind connect create getattr getopt ioctl lock map read setattr setopt shutdown write };
allow tcmd self:rawip_socket { append bind connect create getattr getopt ioctl lock map read setattr setopt shutdown write };
allow tcmd self:socket { append bind connect create getattr getopt ioctl lock map read setattr setopt shutdown write };
allow tcmd self:tcp_socket { accept append bind connect create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow tcmd self:udp_socket { append bind connect create getattr getopt ioctl lock map read setattr setopt shutdown write };
allow tcmd self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
