#
# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type fpc_ident, domain;
type fpc_ident_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(fpc_ident)

allow fpc_ident binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow fpc_ident bugreport_data_file:file { getattr write };
allow fpc_ident cgroup:dir { add_name lock open remove_name search write };
allow fpc_ident cgroup:file { append lock map open write };
allow fpc_ident cgroup_v2:dir { add_name lock open remove_name search write };
allow fpc_ident cgroup_v2:file { append lock map open write };
allow fpc_ident hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow fpc_ident init:unix_stream_socket { connectto };
allow fpc_ident init_fingerprint:fd { use };
allow fpc_ident init_fingerprint:process { sigchld };
allow fpc_ident ion_device:chr_file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident mnt_vendor_file:dir { search };
allow fpc_ident motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow fpc_ident netutils_wrapper:process { rlimitinh siginh transition };
allow fpc_ident netutils_wrapper_exec:file { execute getattr map open read };
allow fpc_ident property_socket:sock_file { write };
allow fpc_ident rootfs:lnk_file { getattr };
allow fpc_ident same_process_hal_file:file { execute getattr map open read };
allow fpc_ident self:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident self:fd { use };
allow fpc_ident self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow fpc_ident self:file { append getattr ioctl lock map open read watch watch_reads write };
allow fpc_ident self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident self:lockdown { confidentiality };
allow fpc_ident self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow fpc_ident self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow fpc_ident self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow fpc_ident sysfs_fpc:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident sysfs_fpc:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident sysfs_fpc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident system_file:lnk_file { getattr };
allow fpc_ident tee_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow fpc_ident vendor_default_prop:file { getattr map open read };
allow fpc_ident vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident vendor_file_type:file { execute getattr map open read };
allow fpc_ident vendor_file_type:lnk_file { getattr read };
allow fpc_ident vendor_mot_boot_prop:file { getattr map open read };
allow fpc_ident vendor_mot_fingerprint_prop:file { getattr map open read };
allow fpc_ident vendor_mot_fingerprint_prop:property_service { set };
allow fpc_ident vendor_mot_hw_prop:file { getattr map open read };
allow fpc_ident vendor_mot_unique_id_prop:file { getattr map open read };
allow fpc_ident vendor_persist_file:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident vendor_persist_file:lnk_file { read };
allow fpc_ident vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident vendor_sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_kgsl:dir { search };
allow fpc_ident vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow fpc_ident vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow fpc_ident vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };

type_transition fpc_ident crash_dump_exec:process crash_dump;
type_transition fpc_ident netutils_wrapper_exec:process netutils_wrapper;
