#
# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type wdsdaemon, domain;
type wdsdaemon_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(wdsdaemon)

allow wdsdaemon binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow wdsdaemon bugreport_data_file:file { getattr write };
allow wdsdaemon cgroup:dir { add_name lock open remove_name search write };
allow wdsdaemon cgroup:file { append lock map open write };
allow wdsdaemon cgroup_v2:dir { add_name lock open remove_name search write };
allow wdsdaemon cgroup_v2:file { append lock map open write };
allow wdsdaemon hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow wdsdaemon mnt_vendor_file:dir { search };
allow wdsdaemon motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon netutils_wrapper:process { rlimitinh siginh transition };
allow wdsdaemon netutils_wrapper_exec:file { execute getattr map open read };
allow wdsdaemon rootfs:lnk_file { getattr };
allow wdsdaemon same_process_hal_file:file { execute getattr map open read };
allow wdsdaemon self:dir { getattr ioctl lock open read search watch watch_reads };
allow wdsdaemon self:fd { use };
allow wdsdaemon self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow wdsdaemon self:file { append getattr ioctl lock map open read watch watch_reads write };
allow wdsdaemon self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon self:lockdown { confidentiality };
allow wdsdaemon self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow wdsdaemon self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow wdsdaemon self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow wdsdaemon sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow wdsdaemon sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon system_file:lnk_file { getattr };
allow wdsdaemon vendor_default_prop:file { getattr map open read };
allow wdsdaemon vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow wdsdaemon vendor_file_type:file { execute getattr map open read };
allow wdsdaemon vendor_file_type:lnk_file { getattr read };
allow wdsdaemon vendor_mot_boot_prop:file { getattr map open read };
allow wdsdaemon vendor_mot_hw_prop:file { getattr map open read };
allow wdsdaemon vendor_mot_unique_id_prop:file { getattr map open read };
allow wdsdaemon vendor_persist_file:dir { getattr ioctl lock open read search watch watch_reads };
allow wdsdaemon vendor_persist_file:lnk_file { read };
allow wdsdaemon vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow wdsdaemon vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow wdsdaemon vendor_sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_kgsl:dir { search };
allow wdsdaemon vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow wdsdaemon vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow wdsdaemon vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow wdsdaemon vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow wdsdaemon vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };

type_transition wdsdaemon crash_dump_exec:process crash_dump;
type_transition wdsdaemon netutils_wrapper_exec:process netutils_wrapper;


# 上の細かい型は共通ツリーが既に vendor_mot_prop / vendor_nfc_prop で
# 拾っている接頭辞ぶんを持てないので、そちらにも同じ権限を与える。
allow wdsdaemon vendor_mot_prop:file { getattr map open read };

# 上の vendor_mot_*_prop は property_contexts から外したので、
# 実際に当たる bootloader_prop / vendor_default_prop 側にも与える。
allow wdsdaemon bootloader_prop:file { getattr map open read };
# --- 型名のずれの一括補完 ---
# 収穫元の stock ポリシーと device/motorola/common で、同じオブジェクトの型名が
# 食い違う。stock 名のルールは書いてあっても何にも当たらないので、実機で
# ls -Z して確認した実際の型に同じ権限を写す。これまで touchscreen / utags /
# fps ディレクトリ / fingerprint sysfs と 1 つずつ実機ログで出てきたぶんを、
# 残り全部まとめて埋める。
allow wdsdaemon mnt_vendor_file:lnk_file { read };
