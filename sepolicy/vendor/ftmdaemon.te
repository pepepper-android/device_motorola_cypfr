# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type ftmdaemon, domain;
type ftmdaemon_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(ftmdaemon)

allow ftmdaemon binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow ftmdaemon bugreport_data_file:file { getattr write };
allow ftmdaemon cgroup:dir { add_name lock open remove_name search write };
allow ftmdaemon cgroup:file { append lock map open write };
allow ftmdaemon cgroup_v2:dir { add_name lock open remove_name search write };
allow ftmdaemon cgroup_v2:file { append lock map open write };
allow ftmdaemon hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow ftmdaemon mnt_vendor_file:dir { search };
allow ftmdaemon motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon netutils_wrapper:process { rlimitinh siginh transition };
allow ftmdaemon netutils_wrapper_exec:file { execute getattr map open read };
allow ftmdaemon rootfs:lnk_file { getattr };
allow ftmdaemon same_process_hal_file:file { execute getattr map open read };
allow ftmdaemon self:capability { net_admin net_raw };
allow ftmdaemon self:dir { getattr ioctl lock open read search watch watch_reads };
allow ftmdaemon self:fd { use };
allow ftmdaemon self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow ftmdaemon self:file { append getattr ioctl lock map open read watch watch_reads write };
allow ftmdaemon self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon self:lockdown { confidentiality };
allow ftmdaemon self:netlink_generic_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow ftmdaemon self:netlink_kobject_uevent_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow ftmdaemon self:netlink_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow ftmdaemon self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow ftmdaemon self:udp_socket { append bind connect create getattr getopt ioctl lock map read setattr setopt shutdown write };
allow ftmdaemon self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow ftmdaemon self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow ftmdaemon sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow ftmdaemon sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon system_file:lnk_file { getattr };
allow ftmdaemon vendor_default_prop:file { getattr map open read };
allow ftmdaemon vendor_diag-router:unix_stream_socket { connectto };
allow ftmdaemon vendor_diag_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow ftmdaemon vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow ftmdaemon vendor_file_type:file { execute getattr map open read };
allow ftmdaemon vendor_file_type:lnk_file { getattr read };
allow ftmdaemon vendor_mot_boot_prop:file { getattr map open read };
allow ftmdaemon vendor_mot_hw_prop:file { getattr map open read };
allow ftmdaemon vendor_mot_unique_id_prop:file { getattr map open read };
allow ftmdaemon vendor_persist_file:dir { getattr ioctl lock open read search watch watch_reads };
allow ftmdaemon vendor_persist_file:lnk_file { read };
allow ftmdaemon vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow ftmdaemon vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow ftmdaemon vendor_sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_kgsl:dir { search };
allow ftmdaemon vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow ftmdaemon vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow ftmdaemon vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow ftmdaemon vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow ftmdaemon vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };

type_transition ftmdaemon crash_dump_exec:process crash_dump;
type_transition ftmdaemon netutils_wrapper_exec:process netutils_wrapper;


# 上の細かい型は共通ツリーが既に vendor_mot_prop / vendor_nfc_prop で
# 拾っている接頭辞ぶんを持てないので、そちらにも同じ権限を与える。
allow ftmdaemon vendor_mot_prop:file { getattr map open read };

# 上の vendor_mot_*_prop は property_contexts から外したので、
# 実際に当たる bootloader_prop / vendor_default_prop 側にも与える。
allow ftmdaemon bootloader_prop:file { getattr map open read };
# --- 型名のずれの一括補完 ---
# 収穫元の stock ポリシーと device/motorola/common で、同じオブジェクトの型名が
# 食い違う。stock 名のルールは書いてあっても何にも当たらないので、実機で
# ls -Z して確認した実際の型に同じ権限を写す。これまで touchscreen / utags /
# fps ディレクトリ / fingerprint sysfs と 1 つずつ実機ログで出てきたぶんを、
# 残り全部まとめて埋める。
allow ftmdaemon mnt_vendor_file:lnk_file { read };
