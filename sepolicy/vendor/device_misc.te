#
# 実機の起動ログから。ドメインごとに 1-2 本しかないので 1 ファイルにまとめる。

# system_suspend が vendor_sysfs_battery_supply を読めない件はここでは直せない。
# system_suspend は coredomain なので vendor ポリシーからは型すら見えず、
# かといって system_ext 側からは vendor_sysfs_battery_supply が見えない。
# /sys/class/power_supply を core 側の型 (sysfs_batteryinfo) で貼り直すのが
# 筋だが、それは device/motorola/common の genfs_contexts に手を入れる話に
# なるので別途。26 件。

# 振動 HAL が /sys の強度ノードに書く。
allow hal_vibrator_default sysfs:file rw_file_perms;

# 指紋 HAL が perf HAL にヒントを投げる。
allow hal_fingerprint_default vendor_hal_perf_default:binder call;
allow hal_fingerprint_default vendor_hal_perf_hwservice:hwservice_manager find;

# eSE の HAL が NFC のプロパティを立てる。
allow hal_secure_element_default vendor_mot_nfc_prop:property_service set;
allow hal_secure_element_default property_socket:sock_file write;
allow hal_secure_element_default init:unix_stream_socket connectto;

# ramdump 収集が /data を覗く。
allow vendor_subsystem_ramdump mnt_user_file:dir search;
allow vendor_subsystem_ramdump vendor_data_file:dir r_dir_perms;

# /mnt/vendor/persist/factory をカーネルが読む - utags の初期値。
allow kernel mnt_vendor_file:dir search;
allow kernel persist_factory_file:dir search;
allow kernel persist_factory_file:file r_file_perms;

# installd がパーティションごとの使用量を数えるとき、読み取り専用で
# マウントされている vendor 配下の別パーティションまで数えにいく。
allow installd { bt_firmware_file firmware_file fsg_file }:filesystem quotaget;

# /vendor/fsg のマウント。fsg_file は common/sepolicy/vendor で宣言され、
# BoardConfig が context= で指定しているが associate が無かった。
allow fsg_file fsg_file:filesystem associate;

# libprocessgroup が cgroup の中身に signal を送るときに出る。自分自身への
# kill なので実害は無いが、enforcing では毎回 denial になる。
allow vdc self:capability kill;
allow fsck self:capability kill;
# linkerconfig も同じ理由で外してある。1 件。
allow vendor_qti_init_shell self:capability kill;
allow vendor_qti_init_shell sysfs:file write;

# Motorola の init スクリプトが USB のガジェット設定と kmsg に書く。
allow vendor_moto_init_shell sysfs_android_usb:dir search;
allow vendor_moto_init_shell sysfs_android_usb:file rw_file_perms;
allow vendor_moto_init_shell kmsg_device:chr_file { open write };
allow vendor_moto_init_shell vendor_mot_fingerprint_prop:property_service set;
allow vendor_moto_init_shell { system_prop vendor_radio_prop }:file r_file_perms;

# Settings のメモリ情報が /proc/swaps を読む。platform_app のうち
# MemoryInfoThread からで、起動ログの platform_app 57 件のうち 42 件。
allow platform_app proc_swaps:file r_file_perms;

# 同じく Settings 系がリフレッシュレートを見にいく。
allow platform_app vendor_sysfs_graphics:dir search;
allow platform_app vendor_sysfs_graphics:file r_file_perms;

# init が振動モーターの trigger ノードに書く。
allow init sysfs:file { open setattr write };

# /vendor/fsg のマウント。
allow init fsg_file:filesystem { getattr mount relabelfrom };

# uevent の受信。
allow init self:netlink_kobject_uevent_socket { bind create getopt read setopt };

# vendor_init が init rc から立てるプロパティ。型は宣言されているのに
# vendor_init に set の許可が無かったもの:
#
#   persist.vendor.camera.physical.num      vendor_camera_prop
#   persist.vendor.ims.cam_sensor_delay     vendor_ims_prop
#   persist.vendor.nfc.config_file_name     vendor_nfc_prop
#   persist.nfc_cfg.config_file_name        nfc_prop
#   persist.vendor.rcs.presence.provision   vendor_persist_rcs_prop
#   persist.vendor.ssr.restart_level        vendor_ssr_prop
set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_ims_prop)
set_prop(vendor_init, vendor_nfc_prop)
set_prop(vendor_init, nfc_prop)
set_prop(vendor_init, vendor_persist_rcs_prop)
set_prop(vendor_init, vendor_ssr_prop)

# persist.demo.hdmirotationlock と ro.hardware は default_prop /
# bootloader_prop に落ちる。core 側の型を vendor_init に書かせるのは
# neverallow に触れるので、ここでは触らない。プロパティが立たないだけで、
# 前者はデモモードの画面回転ロック、後者は既に別経路で入っている。

# rild が android.frameworks.sensorservice.ISensorManager を探す。fwk_ で
# 始まるサービスは vendor から引くために framework が出しているものなので、
# find を与えるのが想定された使い方。
allow rild fwk_sensor_service:service_manager find;

# 実機の denial から、プロパティを 1 つずつ。
allow hal_camera_default vendor_persist_tcm_prop:file r_file_perms;
# hal_audio_sysbta は sysbta が system 側で動くぶん core のドメインなので、
# vendor ポリシーからは型すら見えない。vendor_default_prop を読めない件は
# ここでは直せない。3 件。

# bionic のプロパティ領域走査。hal_camera_default と同じ理由でこちらも黙らせる。
# read は落とさないので、本当に読めなくて困る場合は denial として出る。
dontaudit {
    hal_camera_desktop
    vendor_thermal-engine
    vendor_qti_init_shell
    vendor_moto_init_shell
    vendor_wcnss_service
    rild
} property_type:file { getattr map open };

# org.codeaurora.ims が motoexttelephony を探しにくるが、この ROM は
# Motorola の拡張テレフォニーアプリを積んでいないので、そもそも存在しない。
# 見つからないのが正しい挙動なので、ログだけ止める。
dontaudit vendor_qtelephony default_android_service:service_manager find;

# これが enforcing で起動しなかった原因。
#
# init.oem.hw.sh:207
#   eval motobox expat -u -f $xml_file $device_params "$@"
#
# motobox は Motorola の busybox 相当で、このスクリプトはその expat で
# ハードウェア構成の XML を解析して ro.vendor.hw.* を組み立てる。そして
# init.mmi.rc の on early-init は
#
#   exec_start vendor.oem-hw-sh
#
# で init をブロックして走らせ、その後に ro.sf.lcd_density や
# ro.product.vendor.* の setprop と trigger mmi-priority が続く。ここで
# こければ以降が全部落ちる。permissive では素通りしていた。
#
# motobox に独自の型を与えたとき、stock 由来の 23 ドメインには
# motobox_exec の許可が付いてきたが、このスクリプトを実際に走らせるのは
# 共通ツリーの vendor_moto_init_shell のほうで、そちらには何も付かなかった。
# stock では init.oem.hw.sh が init_hw ドメインで動くのでこの穴は開かない。
allow vendor_moto_init_shell motobox_exec:file rx_file_perms;

# debugfs の tracing。init が mount できないだけで致命ではないが、
# enforcing では毎回出る。
allow init debugfs_tracing_debug:dir mounton;

# サーマルが /proc/loadavg を見る。
allow vendor_thermal-engine proc_loadavg:file r_file_perms;

# crash_dump が RRO の中身を読む (スタックトレースの解決)。
allow crash_dump vendor_overlay_file:file r_file_perms;

# init.oem.hw.sh はハードウェア構成からこれらを組み立てて設定する。stock では
# init_hw ドメインで動くのでその許可を持つが、この端末では
# device/motorola/common の file_contexts が vendor_moto_init_shell_exec を
# 当てており (私のパターンより具体的で勝つ)、そちらのドメインで動く。
# common 側には手を入れず、ここで足す。
set_prop(vendor_moto_init_shell, vendor_mot_product_prop)
set_prop(vendor_moto_init_shell, vendor_mot_init_prop)

# 起動経路の oneshot サービス 28 個を enforcing 下で init に ctl.start させて
# 洗い出したもの。

# cypfr は指紋センサーが二社構成で、fpc_hal と ets_hal が同じ HIDL を出す。
# 使わない方を init スクリプトが止めるので ctl.stop が要る。common 側には
# ctl_start_prop だけがあって対になっていなかった。
#   avc: denied { set } for property=ctl.stop$ets_hal
allow vendor_moto_init_shell ctl_stop_prop:property_service set;

# QTI の init スクリプトが wifi のプロパティを読む。wifi_prop は
# system_public_prop なので vendor から読んで差し支えない。
get_prop(vendor_qti_init_shell, wifi_prop)

# FPC センサーの sysfs を指紋 HAL が読む。
allow hal_fingerprint_default sysfs_fpc:dir r_dir_perms;
allow hal_fingerprint_default sysfs_fpc:file r_file_perms;
