# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type tcmdhelp, domain;
type tcmdhelp_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(tcmdhelp)

allow tcmdhelp audio_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmdhelp audio_device:dir { search };
allow tcmdhelp binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmdhelp block_device:dir { search };
allow tcmdhelp bugreport_data_file:file { getattr write };
allow tcmdhelp cgroup:dir { add_name lock open remove_name search write };
allow tcmdhelp cgroup:file { append lock map open write };
allow tcmdhelp cgroup_v2:dir { add_name lock open remove_name search write };
allow tcmdhelp cgroup_v2:file { append lock map open write };
allow tcmdhelp ctl_default_prop:file { getattr map open read };
allow tcmdhelp ctl_default_prop:property_service { set };
allow tcmdhelp firmware_file:dir { search };
allow tcmdhelp firmware_file:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp hidl_manager_hwservice:hwservice_manager { find };
allow tcmdhelp hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmdhelp hwservicemanager:binder { call transfer };
allow tcmdhelp hwservicemanager_prop:file { getattr map open read };
allow tcmdhelp init:unix_stream_socket { connectto };
allow tcmdhelp kernel:key { search };
allow tcmdhelp mnt_user_file:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp mnt_user_file:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp mnt_vendor_file:dir { search };
allow tcmdhelp motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp netutils_wrapper:process { rlimitinh siginh transition };
allow tcmdhelp netutils_wrapper_exec:file { execute getattr map open read };
allow tcmdhelp node:tcp_socket { node_bind };
allow tcmdhelp pds_att_omadm_file:dir { add_name getattr ioctl lock open read remove_name rmdir search watch watch_reads write };
allow tcmdhelp pds_att_omadm_file:file { getattr unlink };
allow tcmdhelp pds_batt_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow tcmdhelp pds_batt_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow tcmdhelp pds_oma_file:dir { add_name getattr ioctl lock open read remove_name rmdir search watch watch_reads write };
allow tcmdhelp pds_oma_file:file { getattr unlink };
allow tcmdhelp pds_omadm_file:dir { add_name getattr ioctl lock open read remove_name rmdir search watch watch_reads write };
allow tcmdhelp pds_omadm_file:file { getattr unlink };
allow tcmdhelp pds_public_file:dir { search };
allow tcmdhelp pds_usc_dm_file:dir { add_name getattr ioctl lock open read remove_name rmdir search watch watch_reads write };
allow tcmdhelp pds_usc_dm_file:file { getattr unlink };
allow tcmdhelp port:tcp_socket { name_bind };
allow tcmdhelp proc_hwconf:dir { search };
allow tcmdhelp proc_hwconf:file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmdhelp property_socket:sock_file { write };
allow tcmdhelp rootfs:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp rootfs:lnk_file { getattr };
allow tcmdhelp rtc_device:chr_file { read write };
allow tcmdhelp same_process_hal_file:file { execute getattr map open read };
allow tcmdhelp sdcard_type:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow tcmdhelp sdcard_type:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow tcmdhelp self:capability { chown fowner net_admin net_raw sys_module sys_time };
allow tcmdhelp self:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp self:fd { use };
allow tcmdhelp self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmdhelp self:file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmdhelp self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp self:lockdown { confidentiality };
allow tcmdhelp self:netlink_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow tcmdhelp self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow tcmdhelp self:qipcrtr_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow tcmdhelp self:tcp_socket { accept append bind connect create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow tcmdhelp self:udp_socket { append bind connect create getattr getopt ioctl lock map read setattr setopt shutdown write };
allow tcmdhelp self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow tcmdhelp self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow tcmdhelp sns_mot_client:process { rlimitinh siginh transition };
allow tcmdhelp sns_mot_client_exec:file { execute getattr map open read };
allow tcmdhelp storage_file:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp storage_file:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp sysfs:file { append getattr ioctl lock map open read setattr watch watch_reads write };
allow tcmdhelp sysfs_fs_incfs_features:file { append getattr ioctl lock map open read setattr watch watch_reads write };
allow tcmdhelp sysfs_fs_incfs_metrics:file { append getattr ioctl lock map open read setattr watch watch_reads write };
allow tcmdhelp sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp system_file:lnk_file { getattr };
allow tcmdhelp system_file:system { module_load };
allow tcmdhelp tmpfs:dir { search };
allow tcmdhelp utags_block_device:blk_file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmdhelp vendor_default_prop:file { getattr map open read };
allow tcmdhelp vendor_diag_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmdhelp vendor_file:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_file:system { module_load };
allow tcmdhelp vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp vendor_file_type:file { execute getattr map open read };
allow tcmdhelp vendor_file_type:lnk_file { getattr read };
allow tcmdhelp vendor_fm_radio_device:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_memtest_data_file:dir { search };
allow tcmdhelp vendor_memtest_data_file:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_mot_boot_prop:file { getattr map open read };
allow tcmdhelp vendor_mot_ctl_ftmipcd_prop:file { getattr map open read };
allow tcmdhelp vendor_mot_ctl_ftmipcd_prop:property_service { set };
allow tcmdhelp vendor_mot_hw_prop:file { getattr map open read };
allow tcmdhelp vendor_mot_tcmd_prop:file { getattr map open read };
allow tcmdhelp vendor_mot_tcmd_prop:property_service { set };
allow tcmdhelp vendor_mot_unique_id_prop:file { getattr map open read };
allow tcmdhelp vendor_persist_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow tcmdhelp vendor_persist_file:file { append getattr ioctl lock map open read watch watch_reads write };
allow tcmdhelp vendor_persist_file:lnk_file { read };
allow tcmdhelp vendor_sensors_prop:file { getattr map open read };
allow tcmdhelp vendor_shell_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp vendor_sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_kgsl:dir { search };
allow tcmdhelp vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow tcmdhelp vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_toolbox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };
allow tcmdhelp vendor_wcnss_service:process { rlimitinh siginh transition };
allow tcmdhelp vendor_wcnss_service_exec:file { execute getattr map open read };

type_transition tcmdhelp crash_dump_exec:process crash_dump;
type_transition tcmdhelp netutils_wrapper_exec:process netutils_wrapper;
type_transition tcmdhelp sns_mot_client_exec:process sns_mot_client;
type_transition tcmdhelp vendor_wcnss_service_exec:process vendor_wcnss_service;


# 上の細かい型は共通ツリーが既に vendor_mot_prop / vendor_nfc_prop で
# 拾っている接頭辞ぶんを持てないので、そちらにも同じ権限を与える。
allow tcmdhelp vendor_mot_prop:file { getattr map open read };

# 上の型が当たらないパスは共通ツリーが別の型で拾っているので、
# そちらにも同じ権限を与える。
allow tcmdhelp vendor_proc_hw:dir { search };
allow tcmdhelp vendor_proc_hw:file { append getattr ioctl lock map open read watch watch_reads write };