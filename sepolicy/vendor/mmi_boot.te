#
# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type mmi_boot, domain;
type mmi_boot_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(mmi_boot)

allow mmi_boot binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot block_device:dir { search };
allow mmi_boot bugreport_data_file:file { getattr write };
allow mmi_boot cgroup:dir { add_name lock open remove_name search write };
allow mmi_boot cgroup:file { append lock map open write };
allow mmi_boot cgroup_v2:dir { add_name lock open remove_name search write };
allow mmi_boot cgroup_v2:file { append lock map open write };
allow mmi_boot hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot init:unix_stream_socket { connectto };
allow mmi_boot kmsg_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot mnt_vendor_file:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot mnt_vendor_file:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot mnt_vendor_file:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow mmi_boot netutils_wrapper:process { rlimitinh siginh transition };
allow mmi_boot netutils_wrapper_exec:file { execute getattr map open read };
allow mmi_boot persist_factory_file:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot persist_factory_file:file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot persist_factory_file:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot proc:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot proc:file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot proc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot proc_bootconfig:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot proc_bootconfig:file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot proc_bootconfig:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot proc_bootinfo:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot proc_cmdline:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot proc_hwconf:dir { search };
allow mmi_boot proc_hwconf:file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot property_socket:sock_file { write };
allow mmi_boot rootfs:lnk_file { getattr };
allow mmi_boot same_process_hal_file:file { execute getattr map open read };
allow mmi_boot self:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot self:fd { use };
allow mmi_boot self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot self:file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot self:lockdown { confidentiality };
allow mmi_boot self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow mmi_boot self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow mmi_boot self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow mmi_boot sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot system_file:lnk_file { getattr };
allow mmi_boot utags_block_device:blk_file { append getattr ioctl lock map open read watch watch_reads write };
allow mmi_boot vendor_default_prop:file { getattr map open read };
allow mmi_boot vendor_file:file { execute_no_trans };
allow mmi_boot vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot vendor_file_type:file { execute getattr map open read };
allow mmi_boot vendor_file_type:lnk_file { getattr read };
allow mmi_boot vendor_mot_boot_prop:file { getattr map open read };
allow mmi_boot vendor_mot_hw_boardversion_prop:file { getattr map open read };
allow mmi_boot vendor_mot_hw_boardversion_prop:property_service { set };
allow mmi_boot vendor_mot_hw_prop:file { getattr map open read };
allow mmi_boot vendor_mot_hw_prop:property_service { set };
allow mmi_boot vendor_mot_init_prop:file { getattr map open read };
allow mmi_boot vendor_mot_init_prop:property_service { set };
allow mmi_boot vendor_mot_unique_id_prop:file { getattr map open read };
allow mmi_boot vendor_persist_file:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot vendor_persist_file:lnk_file { read };
allow mmi_boot vendor_shell_exec:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot vendor_sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_kgsl:dir { search };
allow mmi_boot vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow mmi_boot vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_toolbox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };

type_transition mmi_boot crash_dump_exec:process crash_dump;
type_transition mmi_boot netutils_wrapper_exec:process netutils_wrapper;


# 上の細かい型は共通ツリーが既に vendor_mot_prop / vendor_nfc_prop で
# 拾っている接頭辞ぶんを持てないので、そちらにも同じ権限を与える。
allow mmi_boot vendor_mot_prop:file { getattr map open read };
allow mmi_boot vendor_mot_prop:property_service { set };

# 上の型が当たらないパスは共通ツリーが別の型で拾っているので、
# そちらにも同じ権限を与える。
allow mmi_boot vendor_proc_hw:file { getattr ioctl lock map open read watch watch_reads };
allow mmi_boot vendor_proc_hw:dir { search };
allow mmi_boot vendor_proc_hw:file { append getattr ioctl lock map open read watch watch_reads write };

# 上の vendor_mot_*_prop は property_contexts から外したので、
# 実際に当たる bootloader_prop / vendor_default_prop 側にも与える。
allow mmi_boot bootloader_prop:file { getattr map open read };
allow mmi_boot vendor_default_prop:property_service { set };