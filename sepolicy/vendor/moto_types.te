type vendor_factory_tmp_file, file_type;
type vendor_hal_fingerprint_fpc, domain, hal_fingerprint_server, halserverdomain;
type vendor_memtest_data_file, data_file_type, file_type;
type vendor_qdss_device, dev_type;
type vendor_unique_id_file, fs_type, sysfs_type;

# 我々が起動しないデーモンの exec 型。ドメインは作っていないが、
# 起動するデーモンの側が execute_no_trans や getattr で参照するので
# 宣言だけ要る。motobox は積んでいるので file_contexts でも当てる。
type motobox_exec, exec_type, file_type, vendor_file_type;
type kpgather_exec, exec_type, file_type, vendor_file_type;
type memtest_exec, exec_type, file_type, vendor_file_type;
type sensor_hub_exec, exec_type, file_type, vendor_file_type;
type sns_mot_client_exec, exec_type, file_type, vendor_file_type;

# Motorola 独自 prop
vendor_restricted_prop(vendor_hw_gabutton_prop);
vendor_restricted_prop(vendor_mot_aplogd_prop);
vendor_restricted_prop(vendor_mot_boot_prop);
vendor_restricted_prop(vendor_mot_ctl_ftmipcd_prop);
vendor_internal_prop(vendor_mot_ctl_mdlog_prop);
vendor_internal_prop(vendor_mot_ctl_stop_mdlog_prop);
vendor_restricted_prop(vendor_mot_factory_prop);
vendor_restricted_prop(vendor_mot_fingerprint_prop);
vendor_internal_prop(vendor_mot_hw_boardversion_prop);
vendor_restricted_prop(vendor_mot_hw_prop);
# vendor_mot_product_prop と同じ理由で public にする。stock は restricted の
# まま surfaceflinger や vendor_init にも読み取りを許しているが、Treble 分割の
# あるこちらでは coredomain への許可が neverallow に当たる。
#
# これが enforcing 起動でタッチが死んだ原因だった。init.mmi.overlay.rc が
#
#   insmod /vendor/lib/modules/${ro.vendor.mot.gki.path}/ili9882_mmi.ko
#
# と書いており、vendor_init がこのプロパティを読めないと ${...} が空に展開され、
# /vendor/lib/modules//ili9882_mmi.ko という存在しないパスになってタッチ
# ドライバがロードされない。同じ経路に nfc_i2c.ko や gcore_mmi.ko もある。
# 早期起動なので logd がまだ動いておらず、logcat には残らなかった。
vendor_public_prop(vendor_mot_init_prop);
vendor_restricted_prop(vendor_mot_mdlog_prop);
vendor_restricted_prop(vendor_mot_nfc_prop);
# stock は restricted で宣言したうえで allow domain ... read を書き、実質
# 全ドメインに開放している。Treble 分割のあるこちらで domain 属性に許可を
# 足すと coredomain ぶんが neverallow に当たるので、宣言を public にして
# 同じ結果を得る。rild が ro.vendor.product.* を読めず、enforcing 起動で
# 拒否されていた - ro.boot.* を restricted に移したときと同じ罠だった。
vendor_public_prop(vendor_mot_product_prop);
vendor_restricted_prop(vendor_mot_reboot_prop);
vendor_restricted_prop(vendor_mot_tcmd_prop);
vendor_restricted_prop(vendor_mot_touchscreen_prop);
vendor_restricted_prop(vendor_mot_unique_id_prop);
vendor_restricted_prop(vendor_mot_var_prop);

# stock では Motorola 独自 prop をまとめる attribute。mbm_spy が
# これ一つで全部読む。我々が積む機種に無い prop は落としてある。
attribute mot_core_property_type;
typeattribute vendor_hw_gabutton_prop mot_core_property_type;
typeattribute vendor_mot_aplogd_prop mot_core_property_type;
typeattribute vendor_mot_boot_prop mot_core_property_type;
typeattribute vendor_mot_ctl_ftmipcd_prop mot_core_property_type;
typeattribute vendor_mot_factory_prop mot_core_property_type;
typeattribute vendor_mot_fingerprint_prop mot_core_property_type;
typeattribute vendor_mot_hw_prop mot_core_property_type;
typeattribute vendor_mot_init_prop mot_core_property_type;
typeattribute vendor_mot_reboot_prop mot_core_property_type;
typeattribute vendor_mot_tcmd_prop mot_core_property_type;
typeattribute vendor_mot_touchscreen_prop mot_core_property_type;
