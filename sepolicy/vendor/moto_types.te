#
# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。

# Motorola 独自デーモンが参照する型のうち、A15 の
# ポリシーに存在しないもの。

type adspd, domain, mlstrustedsubject;
type adspd_socket, file_type, mlstrustedobject;
type aplog_data_file, data_file_type, file_type;
type bllogs_block_device, dev_type;
