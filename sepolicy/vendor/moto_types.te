type cid_block_device, dev_type;
type clogo_block_device, dev_type;
type dbvc_data_file, data_file_type, file_type;
type etsd_device, dev_type;
type hob_device, dev_type;
type hwrev_data_file, data_file_type, file_type, mlstrustedobject;
type i2c_device, dev_type;
type kpan_block_device, dev_type;
type kpgather, domain;
type localtcmd_socket, file_type;
type mdlog_data_file, data_file_type, file_type, mlstrustedobject;
type mdlog_socket, file_type;
type memtest, domain;
type modem_hob_block_device, dev_type;
type panic_data_file, data_file_type, file_type;
type pds_att_omadm_file, file_type, mlstrustedobject;
type pds_batt_file, file_type;
type pds_hiddenmenu_file, file_type, mlstrustedobject;
type pds_oma_file, file_type, mlstrustedobject;
type pds_omadm_file, file_type;
type pds_public_file, file_type;
type pds_usc_dm_file, file_type;
type persist_camera_dualcal_file, file_type, vendor_persist_type;
type persist_chargeonly_file, file_type;
type persist_factory_file, file_type;
type persist_fps_file, file_type, vendor_persist_type;
type proc_bootinfo, fs_type, proc_type;
type proc_hwconf, fs_type, proc_type;
type psylogs_block_device, dev_type;
type sensor_hub, domain;
type shwi_device, dev_type;
type sns_mot_client, domain;
type sysfs_batt, fs_type, sysfs_type;
type sysfs_capsense, fs_type, sysfs_type;
type sysfs_cnss, fs_type, sysfs_type;
type sysfs_dt_chosen, fs_type, sysfs_type;
type sysfs_fpc, fs_type, sysfs_type;
type sysfs_hwmon, fs_type, sysfs_type;
type sysfs_muc_uart, fs_type, mlstrustedobject, sysfs_type;
type sysfs_panel_vendor_info, fs_type, sysfs_type;
type sysfs_touchclass, fs_type, sysfs_type;
type tcmdhelp_socket, file_type;
type tpapi_tmp, file_type;
type utags_block_device, dev_type;
