#
# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type init_wifi, domain;
type init_wifi_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(init_wifi)

allow init_wifi binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow init_wifi bugreport_data_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow init_wifi bugreport_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow init_wifi cgroup:dir { add_name lock open remove_name search write };
allow init_wifi cgroup:file { append lock map open write };
allow init_wifi cgroup_v2:dir { add_name lock open remove_name search write };
allow init_wifi cgroup_v2:file { append lock map open write };
allow init_wifi hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow init_wifi mnt_vendor_file:dir { search };
allow init_wifi motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow init_wifi netutils_wrapper:process { rlimitinh siginh transition };
allow init_wifi netutils_wrapper_exec:file { execute getattr map open read };
allow init_wifi rootfs:lnk_file { getattr };
allow init_wifi same_process_hal_file:file { execute getattr map open read };
allow init_wifi self:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi self:fd { use };
allow init_wifi self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow init_wifi self:file { append getattr ioctl lock map open read watch watch_reads write };
allow init_wifi self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi self:lockdown { confidentiality };
allow init_wifi self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow init_wifi self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow init_wifi self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow init_wifi sysfs_cnss:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi sysfs_cnss:file { append lock map open write };
allow init_wifi sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi system_file:lnk_file { getattr };
allow init_wifi vendor_default_prop:file { getattr map open read };
allow init_wifi vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi vendor_file_type:file { execute getattr map open read };
allow init_wifi vendor_file_type:lnk_file { getattr read };
allow init_wifi vendor_mot_boot_prop:file { getattr map open read };
allow init_wifi vendor_mot_hw_prop:file { getattr map open read };
allow init_wifi vendor_mot_unique_id_prop:file { getattr map open read };
allow init_wifi vendor_persist_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow init_wifi vendor_persist_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow init_wifi vendor_persist_file:lnk_file { read };
allow init_wifi vendor_shell_exec:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi vendor_sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_kgsl:dir { search };
allow init_wifi vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_toolbox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };
allow init_wifi vendor_wifi_vendor_data_file:dir { getattr ioctl lock open read search watch watch_reads };
allow init_wifi vendor_wifi_vendor_data_file:file { getattr ioctl lock map open read watch watch_reads };

type_transition init_wifi crash_dump_exec:process crash_dump;
type_transition init_wifi netutils_wrapper_exec:process netutils_wrapper;


# 上の細かい型は共通ツリーが既に vendor_mot_prop / vendor_nfc_prop で
# 拾っている接頭辞ぶんを持てないので、そちらにも同じ権限を与える。
allow init_wifi vendor_mot_prop:file { getattr map open read };

# 上の vendor_mot_*_prop は property_contexts から外したので、
# 実際に当たる bootloader_prop / vendor_default_prop 側にも与える。
allow init_wifi bootloader_prop:file { getattr map open read };