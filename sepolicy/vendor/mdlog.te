#
# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type mdlog, domain;
type mdlog_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(mdlog)

allow mdlog binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow mdlog bugreport_data_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow mdlog bugreport_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow mdlog cgroup:dir { add_name lock open remove_name search write };
allow mdlog cgroup:file { append lock map open write };
allow mdlog cgroup_v2:dir { add_name lock open remove_name search write };
allow mdlog cgroup_v2:file { append lock map open write };
allow mdlog hidl_manager_hwservice:hwservice_manager { find };
allow mdlog hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow mdlog hwservicemanager:binder { call transfer };
allow mdlog hwservicemanager_prop:file { getattr map open read };
allow mdlog init:unix_stream_socket { connectto };
allow mdlog mdlog_data_file:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow mdlog mdlog_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow mdlog mdlog_socket:sock_file { write };
allow mdlog mnt_user_file:dir { search };
allow mdlog mnt_user_file:lnk_file { read };
allow mdlog mnt_vendor_file:dir { search };
allow mdlog motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow mdlog netutils_wrapper:process { rlimitinh siginh transition };
allow mdlog netutils_wrapper_exec:file { execute getattr map open read };
allow mdlog property_socket:sock_file { write };
allow mdlog rootfs:lnk_file { getattr };
allow mdlog same_process_hal_file:file { execute getattr map open read };
allow mdlog sdcard_type:dir { add_name create getattr ioctl lock open read remove_name rename reparent rmdir search setattr watch watch_reads write };
allow mdlog sdcard_type:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow mdlog self:cap2_userns { block_suspend };
allow mdlog self:capability2 { block_suspend };
allow mdlog self:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog self:fd { use };
allow mdlog self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow mdlog self:file { append getattr ioctl lock map open read watch watch_reads write };
allow mdlog self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mdlog self:lockdown { confidentiality };
allow mdlog self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow mdlog self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow mdlog self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow mdlog storage_file:dir { search };
allow mdlog storage_file:lnk_file { read };
allow mdlog sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mdlog sysfs_wake_lock:file { append getattr ioctl lock map open read watch watch_reads write };
allow mdlog system_file:lnk_file { getattr };
allow mdlog system_suspend_hwservice:hwservice_manager { find };
allow mdlog system_suspend_server:binder { call transfer };
allow mdlog system_suspend_server:fd { use };
allow mdlog tmpfs:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog vendor_configs_file:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog vendor_configs_file:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_default_prop:file { getattr map open read };
allow mdlog vendor_diag-router:unix_stream_socket { connectto };
allow mdlog vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog vendor_file_type:file { execute getattr map open read };
allow mdlog vendor_file_type:lnk_file { getattr read };
allow mdlog vendor_ipa_dev:chr_file { ioctl open read };
allow mdlog vendor_mot_boot_prop:file { getattr map open read };
allow mdlog vendor_mot_ctl_mdlog_prop:file { getattr map open read };
allow mdlog vendor_mot_ctl_mdlog_prop:property_service { set };
allow mdlog vendor_mot_ctl_stop_mdlog_prop:file { getattr map open read };
allow mdlog vendor_mot_ctl_stop_mdlog_prop:property_service { set };
allow mdlog vendor_mot_hw_prop:file { getattr map open read };
allow mdlog vendor_mot_mdlog_prop:file { getattr map open read };
allow mdlog vendor_mot_mdlog_prop:property_service { set };
allow mdlog vendor_mot_unique_id_prop:file { getattr map open read };
allow mdlog vendor_per_mgr_state_prop:file { getattr map open read };
allow mdlog vendor_persist_file:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog vendor_persist_file:lnk_file { read };
allow mdlog vendor_qdss_device:chr_file { open read write };
allow mdlog vendor_qlogd_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_radio_prop:file { getattr map open read };
allow mdlog vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog vendor_sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_kgsl:dir { search };
allow mdlog vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_qdss_dev:dir { search };
allow mdlog vendor_sysfs_qdss_dev:file { append getattr ioctl lock map open read watch watch_reads write };
allow mdlog vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow mdlog vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_system_prop:file { getattr map open read };
allow mdlog vendor_toolbox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow mdlog vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };

type_transition mdlog crash_dump_exec:process crash_dump;
type_transition mdlog netutils_wrapper_exec:process netutils_wrapper;


# 上の細かい型は共通ツリーが既に vendor_mot_prop / vendor_nfc_prop で
# 拾っている接頭辞ぶんを持てないので、そちらにも同じ権限を与える。
allow mdlog vendor_mot_prop:file { getattr map open read };

# 上の vendor_mot_*_prop は property_contexts から外したので、
# 実際に当たる bootloader_prop / vendor_default_prop 側にも与える。
allow mdlog bootloader_prop:file { getattr map open read };
# --- 型名のずれの一括補完 ---
# 収穫元の stock ポリシーと device/motorola/common で、同じオブジェクトの型名が
# 食い違う。stock 名のルールは書いてあっても何にも当たらないので、実機で
# ls -Z して確認した実際の型に同じ権限を写す。これまで touchscreen / utags /
# fps ディレクトリ / fingerprint sysfs と 1 つずつ実機ログで出てきたぶんを、
# 残り全部まとめて埋める。
allow mdlog mnt_vendor_file:lnk_file { read };
