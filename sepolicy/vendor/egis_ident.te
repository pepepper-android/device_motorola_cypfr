#
# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type egis_ident, domain;
type egis_ident_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(egis_ident)

allow egis_ident binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow egis_ident bugreport_data_file:file { getattr write };
allow egis_ident cgroup:dir { add_name lock open remove_name search write };
allow egis_ident cgroup:file { append lock map open write };
allow egis_ident cgroup_v2:dir { add_name lock open remove_name search write };
allow egis_ident cgroup_v2:file { append lock map open write };
allow egis_ident etsd_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow egis_ident hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow egis_ident init:unix_stream_socket { connectto };
allow egis_ident init_fingerprint:fd { use };
allow egis_ident init_fingerprint:process { sigchld };
allow egis_ident ion_device:chr_file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident mnt_vendor_file:dir { search };
allow egis_ident motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow egis_ident netutils_wrapper:process { rlimitinh siginh transition };
allow egis_ident netutils_wrapper_exec:file { execute getattr map open read };
allow egis_ident property_socket:sock_file { write };
allow egis_ident rootfs:lnk_file { getattr };
allow egis_ident same_process_hal_file:file { execute getattr map open read };
allow egis_ident self:dir { getattr ioctl lock open read search watch watch_reads };
allow egis_ident self:fd { use };
allow egis_ident self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow egis_ident self:file { append getattr ioctl lock map open read watch watch_reads write };
allow egis_ident self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident self:lockdown { confidentiality };
allow egis_ident self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow egis_ident self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow egis_ident self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow egis_ident sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow egis_ident sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident system_file:lnk_file { getattr };
allow egis_ident tee_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow egis_ident vendor_default_prop:file { getattr map open read };
allow egis_ident vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow egis_ident vendor_file_type:file { execute getattr map open read };
allow egis_ident vendor_file_type:lnk_file { getattr read };
allow egis_ident vendor_mot_boot_prop:file { getattr map open read };
allow egis_ident vendor_mot_fingerprint_prop:file { getattr map open read };
allow egis_ident vendor_mot_fingerprint_prop:property_service { set };
allow egis_ident vendor_mot_hw_prop:file { getattr map open read };
allow egis_ident vendor_mot_unique_id_prop:file { getattr map open read };
allow egis_ident vendor_persist_file:dir { getattr ioctl lock open read search watch watch_reads };
allow egis_ident vendor_persist_file:lnk_file { read };
allow egis_ident vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow egis_ident vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow egis_ident vendor_sysfs_graphics:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_kgsl:dir { search };
allow egis_ident vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow egis_ident vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow egis_ident vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow egis_ident vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow egis_ident vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };

type_transition egis_ident crash_dump_exec:process crash_dump;
type_transition egis_ident netutils_wrapper_exec:process netutils_wrapper;


# 上の細かい型は共通ツリーが既に vendor_mot_prop / vendor_nfc_prop で
# 拾っている接頭辞ぶんを持てないので、そちらにも同じ権限を与える。
allow egis_ident vendor_mot_prop:file { getattr map open read };
allow egis_ident vendor_mot_prop:property_service { set };

# 上の vendor_mot_*_prop は property_contexts から外したので、
# 実際に当たる bootloader_prop / vendor_default_prop 側にも与える。
allow egis_ident bootloader_prop:file { getattr map open read };