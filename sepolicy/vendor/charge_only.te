# stock の vendor パーティションが積んでいる precompiled_sepolicy を
# checkpolicy -b -M -C で CIL に戻し、そこから機械的に書き出したもの。
# Motorola 自身のポリシーなので、手で書き起こすより取りこぼしが少ない。


type charge_only, domain;
type charge_only_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(charge_only)

allow charge_only binder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only bugreport_data_file:file { getattr write };
allow charge_only cgroup:dir { add_name lock open remove_name search write };
allow charge_only cgroup:file { append lock map open write };
allow charge_only cgroup_v2:dir { add_name lock open remove_name search write };
allow charge_only cgroup_v2:file { append lock map open write };
allow charge_only chargeonly_data_file:dir { add_name getattr ioctl lock open read remove_name search watch watch_reads write };
allow charge_only chargeonly_data_file:file { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow charge_only graphics_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only graphics_device:dir { search };
allow charge_only hidl_manager_hwservice:hwservice_manager { find };
allow charge_only hwbinder_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only hwservicemanager:binder { call transfer };
allow charge_only hwservicemanager_prop:file { getattr map open read };
allow charge_only init:unix_stream_socket { connectto };
allow charge_only input_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only input_device:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only memtest:process { rlimitinh siginh transition };
allow charge_only memtest_exec:file { execute getattr map open read };
allow charge_only mnt_vendor_file:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only motobox_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow charge_only netutils_wrapper:process { rlimitinh siginh transition };
allow charge_only netutils_wrapper_exec:file { execute getattr map open read };
allow charge_only persist_chargeonly_file:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only persist_chargeonly_file:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only powerctl_prop:file { getattr map open read };
allow charge_only powerctl_prop:property_service { set };
allow charge_only property_socket:sock_file { write };
allow charge_only rootfs:lnk_file { getattr };
allow charge_only rtc_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only same_process_hal_file:file { execute getattr map open read };
allow charge_only self:cap2_userns { block_suspend };
allow charge_only self:capability2 { block_suspend };
allow charge_only self:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only self:fd { use };
allow charge_only self:fifo_file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only self:file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only self:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow charge_only self:lockdown { confidentiality };
allow charge_only self:netlink_kobject_uevent_socket { append bind connect create getattr getopt lock map read setattr setopt shutdown write };
allow charge_only self:process { fork getattr getcap getpgid getsched getsession setcap setpgid setrlimit setsched sigchld sigkill signal signull sigstop };
allow charge_only self:unix_dgram_socket { append bind connect create getattr getopt ioctl lock map read sendto setattr setopt shutdown write };
allow charge_only self:unix_stream_socket { accept append bind connect connectto create getattr getopt ioctl listen lock map read setattr setopt shutdown write };
allow charge_only sysfs:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only sysfs_batteryinfo:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only sysfs_batteryinfo:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only sysfs_batteryinfo:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow charge_only sysfs_fs_incfs_features:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only sysfs_fs_incfs_metrics:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only sysfs_leds:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only sysfs_leds:file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only sysfs_power:file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only sysfs_thermal:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only sysfs_thermal:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only sysfs_thermal:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow charge_only sysfs_wake_lock:file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only system_file:lnk_file { getattr };
allow charge_only system_suspend_hwservice:hwservice_manager { find };
allow charge_only system_suspend_server:binder { call transfer };
allow charge_only system_suspend_server:fd { use };
allow charge_only tty_device:chr_file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only vendor_default_prop:file { getattr map open read };
allow charge_only vendor_display_prop:file { getattr map open read };
allow charge_only vendor_file_type:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only vendor_file_type:file { execute getattr map open read };
allow charge_only vendor_file_type:lnk_file { getattr read };
allow charge_only vendor_mot_boot_prop:file { getattr map open read };
allow charge_only vendor_mot_hw_prop:file { getattr map open read };
allow charge_only vendor_mot_init_prop:file { getattr map open read };
allow charge_only vendor_mot_unique_id_prop:file { getattr map open read };
allow charge_only vendor_persist_file:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only vendor_persist_file:lnk_file { read };
allow charge_only vendor_shell_exec:file { execute execute_no_trans getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_battery_supply:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only vendor_sysfs_battery_supply:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_battery_supply:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_esoc:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only vendor_sysfs_esoc:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_esoc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_gpu_max_clock:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_graphics:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only vendor_sysfs_graphics:file { append getattr ioctl lock map open read watch watch_reads write };
allow charge_only vendor_sysfs_graphics:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_kgsl:dir { search };
allow charge_only vendor_sysfs_kgsl_gpu_model:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_kgsl_gpubusy:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_kgsl_max_gpuclk:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_public:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only vendor_sysfs_public:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_public:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_soc:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only vendor_sysfs_soc:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_soc:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_ssr:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only vendor_sysfs_ssr:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_ssr:lnk_file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_sysfs_usb_supply:dir { getattr ioctl lock open read search watch watch_reads };
allow charge_only vendor_sysfs_usb_supply:file { getattr ioctl lock map open read watch watch_reads };
allow charge_only vendor_unique_id_file:file { getattr ioctl lock map open read watch watch_reads };

type_transition charge_only crash_dump_exec:process crash_dump;
type_transition charge_only memtest_exec:process memtest;
type_transition charge_only netutils_wrapper_exec:process netutils_wrapper;
